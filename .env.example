# ==============================================================================
# FOXREVO REVOLUTION - ENVIRONMENT VARIABLES
# Do not commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONFIGURATION
# Get these from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="your-supabase-project-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# The Service Role Key is strictly for backend routes (like webhooks) 
# to bypass RLS and update payment records securely. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. FLUTTERWAVE PAYMENT GATEWAY
# Get these from your Flutterwave Dashboard -> Settings -> API Keys
# ------------------------------------------------------------------------------
FLUTTERWAVE_PUBLIC_KEY="your-flutterwave-public-key"
FLUTTERWAVE_SECRET_KEY="your-flutterwave-secret-key"

# The Secret Hash is a custom string you define in your Flutterwave Webhook settings.
# It ensures that webhooks received are genuinely from Flutterwave.
FLUTTERWAVE_SECRET_HASH="foxrevo_secure_webhook_hash_12345"

# ------------------------------------------------------------------------------
# 3. APPLICATION URL
# Used for redirecting the user back after payment
# In production, change this to "https://foxrevo.com"
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
